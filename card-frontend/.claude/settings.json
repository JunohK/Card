{
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npx tsc:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)"
    ],
    "deny": [
      "Read(.env)",        "Edit(.env)",
      "Read(.env.local)",  "Edit(.env.local)",
      "Read(.env.production)", "Edit(.env.production)",
      "Read(.env.*)",      "Edit(.env.*)"
    ]
  }
}
